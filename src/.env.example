# Copy to .env and adjust. docker-compose reads this for ${...} substitution.
# Do NOT commit a real .env -- it is gitignored.

# ── production defaults (secure) ──────────────────────────────────────────────
GUARD_MODE=enforce
GUARD_TRUSTED_PROXY_HOPS=0
GUARD_TRUST_LABEL_HEADER=false

# ── lab / data-generation ─────────────────────────────────────────────────────
# Prefer the compose override, which sets these explicitly:
#   docker compose -f docker-compose.yml -f docker-compose.lab.yml up -d
#
# GUARD_MODE=monitor
# GUARD_TRUSTED_PROXY_HOPS=1
# GUARD_TRUST_LABEL_HEADER=true
