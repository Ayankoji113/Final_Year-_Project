.idea/
__pycache__/
*.pyc
node_modules/
.env
.pytest_cache/

# Local interpreter and the vendored sklearn workaround. These were committed
# previously (10,000+ files); they are environment, not source.
src/ml_pipeline/venv/
src/ml_pipeline/sklearn_portable/

# Generated corpus. Regenerate with traffic_simulator/generate.py -- it is
# large, machine-specific, and must never be a substitute for reproducing the
# pipeline.
src/data/*.jsonl

# Trained artefacts and calibration backups.
src/ml_pipeline/models/*.bak
src/legacy/

# Keep the model metadata: it records the methodology and the reported
# numbers, which belong in the repository.
!src/ml_pipeline/models/decision.json
!src/ml_pipeline/models/calibration.json

# hyperparameter search / multi-seed validation / reproduction scratch output
src/ml_pipeline/models_tuning/
src/ml_pipeline/models_validate/
src/ml_pipeline/models_verify/

# Word lock files
~$*

# Claude Code local settings. Machine-specific, and can contain API tokens.
.claude/settings.local.json

src/eval_corpus.json
src/ml_pipeline/baseline_*.json

# Model-selection scratch: candidate model sets, corpus snapshots and replay
# corpora from the cross-generator evaluation. The chosen model is copied into
# models/; the rest are reproducible and too large for the repository.
src/ml_pipeline/models_b*/
src/ml_pipeline/models_final/
src/ml_pipeline/models_fixed/
src/ml_pipeline/models_wide/
src/ml_pipeline/models_shipped_prev/
src/data/events_training.jsonl.*
src/eval_seed*.json
src/clean_eval.json
